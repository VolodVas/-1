package Lab_1_v21;
import java.util.Scanner;
public class Lab1_AllTasks_Variant21 {
	public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String choice;

        printHeaderAndHelp();

        do {
            System.out.print("\nВиберіть завдання (1-4) або q/Enter для виходу → ");
            choice = sc.nextLine().trim().toLowerCase();

            switch (choice) {
                case "1":
                    task1(sc);
                    break;
                case "2":
                    task2(sc);
                    break;
                case "3":
                    task3(sc);
                    break;
                case "4":
                    task4(sc);
                    break;
                case "q":
                case "":
                    System.out.println("\nПрограму завершено. До побачення!");
                    break;
                case "h":
                case "?":
                    printHeaderAndHelp();
                    break;
                default:
                    System.out.println("Невірний вибір. Спробуйте 1, 2, 3, 4, q або Enter.");
            }
        } while (!choice.equals("q") && !choice.equals(""));

        sc.close();
    }

    // ────────────────────────────────────────────────
    // Довідка та привітання
    // ────────────────────────────────────────────────
    private static void printHeaderAndHelp() {
        System.out.println("═══════════════════════════════════════════════════════════════");
        System.out.println("     Лабораторна робота №1   |   Варіант 21");
        System.out.println("     Прості консольні програми, розгалуження, switch, винятки");
        System.out.println("═══════════════════════════════════════════════════════════════\n");

        System.out.println("Доступні завдання:");
        System.out.println("  1  → y = { 3x + xz    якщо x=5");
        System.out.println("          2xz/7 - z  якщо x=-5");
        System.out.println("          x          якщо x=0 }");
        System.out.println("  2  → Визначити положення точки відносно кола (всередині / на межі / поза)");
        System.out.println("  3  → Визначити пору року за номером місяця (1–12)");
        System.out.println("  4  → a = √(x² · y) − 14z   з перевіркою допустимих значень");
        System.out.println();
        System.out.println("Команди:");
        System.out.println("  1, 2, 3, 4  → запустити відповідне завдання");
        System.out.println("  h або ?     → показати цю довідку ще раз");
        System.out.println("  q або Enter → вийти з програми");
        System.out.println("═══════════════════════════════════════════════════════════════\n");
    }

    // ────────────────────────────────────────────────
    // Завдання 1 – два способи (тернарний + повний if)
    // ────────────────────────────────────────────────
    private static void task1(Scanner sc) {
        System.out.println("\n┌─────────────────────────────┐");
        System.out.println("│        Завдання 1           │");
        System.out.println("└─────────────────────────────┘");
        System.out.println("Обчислення y залежно від x (цілі x, z)");

        System.out.print("Введіть x: ");
        int x = readInt(sc);
        System.out.print("Введіть z: ");
        int z = readInt(sc);

        double y;

        // Спосіб А: тернарний оператор
        System.out.println("\nСпосіб А (тернарний оператор):");
        y = (x == 5) ? 3.0 * x + x * z :
            (x == -5) ? (2.0 * x * z / 7 - z) :
            (x == 0) ? (double) x : Double.NaN;

        if (!Double.isNaN(y)) {
            System.out.printf("y = %.4f\n", y);
        } else {
            System.out.println("x не дорівнює 5, -5 або 0");
        }

        // Спосіб Б: повний if-else
        System.out.println("\nСпосіб Б (if ... else if):");
        if (x == 5) {
            y = 3.0 * x + x * z;
            System.out.printf("y = 3x + xz = %.4f\n", y);
        } else if (x == -5) {
            y = 2.0 * x * z / 7 - z;
            System.out.printf("y = 2xz/7 - z = %.4f\n", y);
        } else if (x == 0) {
            y = x;
            System.out.printf("y = x = %.4f\n", y);
        } else {
            System.out.println("x не відповідає жодній з умов (5, -5, 0)");
        }

        pressEnterToContinue(sc);
    }

    // ────────────────────────────────────────────────
    // Завдання 2 – точка відносно кола
    // ────────────────────────────────────────────────
    private static void task2(Scanner sc) {
        System.out.println("\n┌─────────────────────────────┐");
        System.out.println("│        Завдання 2           │");
        System.out.println("└─────────────────────────────┘");
        System.out.println("Визначення положення точки А відносно кола з центром О та радіусом R");

        System.out.print("Координати центру O (x0 y0): ");
        double x0 = sc.nextDouble();
        double y0 = sc.nextDouble();
        System.out.print("Радіус R: ");
        double R = sc.nextDouble();
        System.out.print("Координати точки A (x1 y1): ");
        double x1 = sc.nextDouble();
        double y1 = sc.nextDouble();
        sc.nextLine(); // очистка буфера

        double dist = Math.hypot(x1 - x0, y1 - y0);

        System.out.printf("\nВідстань від центра до точки: %.6f\n", dist);

        if (Math.abs(dist - R) < 1e-9) {
            System.out.println("→ Точка лежить НА ОКРУЖНОСТІ");
        } else if (dist < R) {
            System.out.println("→ Точка ВСЕРЕДИНІ кола");
        } else {
            System.out.println("→ Точка ПОЗА колом");
        }

        pressEnterToContinue(sc);
    }

    // ────────────────────────────────────────────────
    // Завдання 3 – пора року з повторним введенням
    // ────────────────────────────────────────────────
    private static void task3(Scanner sc) {
        System.out.println("\n┌─────────────────────────────┐");
        System.out.println("│        Завдання 3           │");
        System.out.println("└─────────────────────────────┘");
        System.out.println("Визначення пори року за номером місяця");

        int month;
        do {
            System.out.print("Введіть номер місяця (1–12): ");
            while (!sc.hasNextInt()) {
                System.out.print("Це не число. Введіть ціле число 1–12: ");
                sc.next();
            }
            month = sc.nextInt();
            sc.nextLine();

            if (month < 1 || month > 12) {
                System.out.println("Неправильно! Має бути від 1 до 12.");
            }
        } while (month < 1 || month > 12);

        String season = switch (month) {
            case 12, 1, 2   -> "Зима";
            case 3, 4, 5    -> "Весна";
            case 6, 7, 8    -> "Літо";
            case 9, 10, 11  -> "Осінь";
            default         -> "???";
        };

        System.out.printf("Місяць %d — це %s\n", month, season);

        pressEnterToContinue(sc);
    }

    // ────────────────────────────────────────────────
    // Завдання 4 – a = √(x²·y) - 14z з винятками
    // ────────────────────────────────────────────────
    private static void task4(Scanner sc) {
        System.out.println("\n┌─────────────────────────────┐");
        System.out.println("│        Завдання 4           │");
        System.out.println("└─────────────────────────────┘");
        System.out.println("Обчислення a = √(x² · y) - 14z");

        System.out.print("Введіть x: ");
        int x = readInt(sc);
        System.out.print("Введіть y: ");
        int y = readInt(sc);
        System.out.print("Введіть z: ");
        int z = readInt(sc);

        try {
            double x2 = (double) x * x;
            double underSqrt = x2 * y;

            if (underSqrt < 0) {
                throw new ArithmeticException(
                    String.format("Корінь з від'ємного числа: x²·y = %.2f < 0", underSqrt));
            }

            double sqrtPart = Math.sqrt(underSqrt);
            double a = sqrtPart - 14.0 * z;

            System.out.println("\nПокроковий розрахунок:");
            System.out.printf("x²          = %.2f\n", x2);
            System.out.printf("x² · y      = %.2f\n", underSqrt);
            System.out.printf("√(x²·y)     = %.6f\n", sqrtPart);
            System.out.printf("14·z        = %.2f\n", 14.0 * z);
            System.out.printf("a           = %.6f\n", a);

        } catch (ArithmeticException e) {
            System.out.println("\nПОМИЛКА: " + e.getMessage());
        }

        pressEnterToContinue(sc);
    }

    // ────────────────────────────────────────────────
    // Допоміжні методи
    // ────────────────────────────────────────────────
    private static int readInt(Scanner sc) {
        while (!sc.hasNextInt()) {
            System.out.print("Введіть ціле число: ");
            sc.next();
        }
        int value = sc.nextInt();
        sc.nextLine(); // очистка
        return value;
    }

    private static void pressEnterToContinue(Scanner sc) {
        System.out.print("\nНатисніть Enter для повернення в меню...");
        sc.nextLine();
    }

}
